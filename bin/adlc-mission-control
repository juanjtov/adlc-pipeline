#!/usr/bin/env bash
# Starts ADLC Mission Control for the repo in the current directory, or reports the one already running.
#   adlc-mission-control --open          start and open the page
#   adlc-mission-control --demo --open   show simulated work, without GitHub
#   adlc-mission-control --repo owner/name --port 4319
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="$(command -v python3 || true)"
if [ -z "$py" ]; then
  echo "Mission Control needs Python 3 (3.9 or newer). Install it, then run this again." >&2
  exit 1
fi
exec "$py" "$here/../mission-control/server.py" "$@"
