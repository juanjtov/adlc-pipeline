      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api -X PUT repos/*/merge:*)",
      "Bash(gh api --method PUT repos/*/merge:*)"
    ]
  }
}
